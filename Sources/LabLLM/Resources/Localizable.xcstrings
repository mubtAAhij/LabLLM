    "tutorial.step1.description": {
      "comment": "Sources/LabLLM/Views/TutorialView.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick Tiny for a quick first run. The estimates update as you change layers, width, and context length."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Tiny para una primera ejecución rápida. Las estimaciones se actualizan a medida que cambias las capas, el ancho y la longitud de contexto."
          }
        }
      }
    },
