    "recipes.preset.overfitting-lab.title": {
      "comment": "Sources/LabLLM/Core/Recipes.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overfitting lab"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Laboratorio de sobreajuste"
          }
        }
      }
    },
    "recipes.preset.overfitting-lab.description": {
      "comment": "Sources/LabLLM/Core/Recipes.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A deliberately oversized model on a deliberately tiny slice of text — the fastest way to see overfitting for yourself."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modelo deliberadamente sobredimensionado sobre una porción de texto deliberadamente pequeña: la forma más rápida de ver el overfitting por ti mismo."
          }
        }
      }
    },
    "recipes.preset.overfitting-lab.watch-for": {
      "comment": "Sources/LabLLM/Core/Recipes.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Training loss keeps diving while validation loss bottoms out and climbs. That gap is overfitting, and it is the reason validation exists."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La pérdida de entrenamiento sigue cayendo mientras que la pérdida de validación toca fondo y empieza a subir. Esa brecha es sobreajuste, y es la razón por la que existe la validación."
          }
        }
      }
    },
