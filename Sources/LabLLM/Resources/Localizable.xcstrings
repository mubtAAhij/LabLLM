    "recipes.preset.tinystories.description": {
      "comment": "Sources/LabLLM/Core/Recipes.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A 6-layer model on simple children's stories — the smallest setup that produces genuinely coherent sentences."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modelo de 6 capas sobre cuentos infantiles simples — la configuración más pequeña que produce oraciones genuinamente coherentes."
          }
        }
      }
    },
    "recipes.preset.tinystories.watch-for": {
      "comment": "Sources/LabLLM/Core/Recipes.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Validation loss keeps falling with training loss. Samples gain grammar, then plot. If val loss flattens while train loss falls, the model has started memorizing."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La pérdida de validación sigue cayendo junto con la pérdida de entrenamiento. Las muestras ganan gramática, luego trama. Si la pérdida de validación se aplana mientras la pérdida de entrenamiento cae, el modelo ha comenzado a memorizar."
          }
        }
      }
    },
    "recipes.dataset.tinystories": {
