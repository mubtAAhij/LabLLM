    "recipes.preset.first-run.description": {
      "comment": "Sources/LabLLM/Core/Recipes.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The smallest end-to-end run in the app: a 4-layer character model on 1 MB of Shakespeare."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La ejecución completa más pequeña de la aplicación: un modelo de caracteres de 4 capas con 1 MB de Shakespeare."
          }
        }
      }
    },
    "recipes.preset.first-run.watch-for": {
      "comment": "Sources/LabLLM/Core/Recipes.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loss drops from ~4.2 (random guessing over the vocabulary) to under 2.0, and the samples turn from noise into word-shaped text."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La pérdida baja de ~4.2 (adivinación aleatoria sobre el vocabulario) a menos de 2.0, y las muestras pasan de ser ruido a texto con forma de palabras."
          }
        }
      }
    },
