    "recipes.preset.chat-lora.title": {
      "comment": "Sources/LabLLM/Core/Recipes.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Teach it to chat (LoRA)"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Enséñale a chatear (LoRA)"
          }
        }
      }
