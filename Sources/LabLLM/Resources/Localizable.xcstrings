    },
    "recipes.preset.instruction-following.watch-for": {
      "comment": "Sources/LabLLM/Core/Recipes.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Responses become instruction-shaped: they answer the asked question and stop, instead of inventing a new question."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las respuestas se vuelven conformes a la instruction: responden la pregunta formulada y se detienen, en lugar de inventar una nueva pregunta."
          }
        }
      }
    },
