    "tutorial.step2.description": {
      "comment": "Sources/LabLLM/Views/TutorialView.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the built-in sample, import a text file, or choose a public corpus from the marketplace. In Simple mode, the tokenizer is built when training starts."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la muestra incorporada, importa un archivo de texto o elige un corpus público del marketplace. En modo Básico, el tokenizador se construye cuando comienza el entrenamiento."
          }
        }
      }
    },
