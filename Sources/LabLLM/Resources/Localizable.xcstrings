    "training-view.pretraining.guidance": {
      "comment": "Sources/LabLLM/Views/TrainingView.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the corpora this run trains on above, then press Start. Watch the loss fall — lower is better. A checkpoint saves periodically and again when the run finishes or is stopped."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige los corpora en los que esta ejecución entrenará arriba y luego presiona Iniciar. Observa cómo cae la pérdida — mientras más baja, mejor. Un checkpoint se guarda periódicamente y nuevamente cuando la ejecución termina o se detiene."
          }
        }
      }
    },
    "training-view.finetune.guidance": {
      "comment": "Sources/LabLLM/Views/TrainingView.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fine-tuning continues from your pretrained (or resumed) model and trains only on the assistant's replies. LoRA trains a small adapter instead of the whole model — faster and swappable."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El ajuste fino continúa desde tu modelo preentrenado (o reanudado) y entrena solo con las respuestas del asistente. LoRA entrena un adaptador pequeño en lugar del modelo completo — más rápido e intercambiable."
          }
        }
      }
    },
    "training-view.dpo.guidance": {
      "comment": "Sources/LabLLM/Views/TrainingView.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DPO needs a fine-tuned model already in memory (run Fine-tune first, or resume from an SFT checkpoint). It nudges the model toward the 'chosen' replies and away from 'rejected' ones."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "DPO necesita un modelo ya afinado en memoria (ejecuta Ajuste fino primero, o reanuda desde un checkpoint de SFT). Empuja al modelo hacia las respuestas \"chosen\" y lo aleja de las \"rejected\"."
          }
        }
      }
    },
