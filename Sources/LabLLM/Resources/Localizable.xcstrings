    "recipes.preset.chat-lora.description": {
      "comment": "Sources/LabLLM/Core/Recipes.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LoRA fine-tune on short everyday conversations, so a pretrained model starts answering instead of continuing text."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste fino con LoRA sobre conversaciones cotidianas cortas, para que un modelo preentrenado empiece a responder en lugar de continuar texto."
          }
        }
      }
    },
    "recipes.preset.chat-lora.watch-for": {
      "comment": "Sources/LabLLM/Core/Recipes.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the assistant turns count toward the loss. After a few hundred steps the model stops rambling and starts replying in turns — check it in Chat."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los turnos del asistente cuentan para la pérdida. Después de algunos cientos de pasos, el modelo deja de divagar y empieza a responder por turnos — veríficalo en Chat."
          }
        }
      }
    },
