      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fine-tuning continues from your pretrained (or resumed) model and trains only on the assistant's replies. LoRA trains a small adapter instead of the whole model — faster and swappable."
          }
        }
      }
    },
