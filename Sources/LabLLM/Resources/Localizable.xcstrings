    "tutorial.step3.description": {
      "comment": "Sources/LabLLM/Views/TutorialView.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a run, then watch loss and the sample timeline. Lower loss usually means the model is learning the patterns in your text."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una ejecución y luego observa la pérdida y la línea de tiempo de muestras. Una pérdida más baja generalmente significa que el modelo está aprendiendo los patrones en tu texto."
          }
        }
      }
    },
